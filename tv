#!/usr/bin/env bash
# tv: the one command for running Turret Vision on the Jetson.
#
#   ./tv doctor     check the Jetson, camera, ESP32 and compute budget (run this first)
#   ./tv up         start the system: hardware if an ESP32 is plugged in, else the simulator
#   ./tv up --sim   start the simulator explicitly
#   ./tv down       stop it
#   ./tv logs       follow the logs
#   ./tv update     pull the latest code and container image
#   ./tv flash      build and flash the ESP32 firmware (stop the system first)
#   ./tv sim        headless simulator run with a score
#   ./tv test       run the test suite inside the container
#   ./tv shell      a shell inside the container
#   ./tv build      build the image locally instead of pulling it
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMPOSE=(docker compose -f "$ROOT/docker/compose.yaml")
mkdir -p "$ROOT/data"

say() { printf '\033[1m%s\033[0m\n' "$*"; }
warn() { printf '\033[33m%s\033[0m\n' "$*"; }
fail() { printf '\033[31m%s\033[0m\n' "$*" >&2; exit 1; }

need_docker() {
  command -v docker >/dev/null || fail "Docker is not installed. JetPack ships it; reinstall with: sudo apt install docker.io"
  docker info >/dev/null 2>&1 || fail "Docker is not usable by $USER. Run: sudo usermod -aG docker $USER  then log out and back in."
  docker compose version >/dev/null 2>&1 || fail "docker compose plugin missing. Run: sudo apt install docker-compose-plugin"
}

ensure_image() {
  # Prefer the CI-built image; fall back to a local build (slower, but works offline).
  if ! docker image inspect "${TURRET_IMAGE:-ghcr.io/viper5579/turret-vision:latest}" >/dev/null 2>&1; then
    say "Pulling the prebuilt image..."
    if ! "${COMPOSE[@]}" pull -q 2>/dev/null; then
      warn "Pull failed (offline, or the package is private). Building locally; this takes a few minutes once."
      "${COMPOSE[@]}" build
    fi
  fi
}

esp32_present() { ls /dev/ttyUSB* /dev/ttyACM* >/dev/null 2>&1; }

host_checks() {
  say "Host"
  if [[ -f /etc/nv_tegra_release ]]; then
    echo "  $(head -1 /etc/nv_tegra_release | cut -d, -f1-2)"
    if command -v nvpmodel >/dev/null; then
      mode=$(sudo -n nvpmodel -q 2>/dev/null | head -1 || true)
      if [[ -z "$mode" ]]; then echo "  power mode: run 'sudo nvpmodel -q' to check (expect MAXN_SUPER)";
      elif [[ "$mode" == *MAXN* ]]; then echo "  power mode: $mode";
      else warn "  power mode: $mode -> sudo nvpmodel -m 2 (MAXN_SUPER) for full speed"; fi
    fi
  else
    echo "  not a Jetson (fine for development)"
  fi
  free_gb=$(df -BG --output=avail "$ROOT/data" | tail -1 | tr -dc 0-9)
  if (( free_gb < 20 )); then warn "  disk: ${free_gb} GB free -> install the NVMe SSD (plan, M0)"; else echo "  disk: ${free_gb} GB free"; fi
  id -nG "$USER" | grep -qw dialout || warn "  $USER is not in 'dialout' (only matters outside Docker): sudo usermod -aG dialout $USER"
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  doctor)
    host_checks
    need_docker
    ensure_image
    if "${COMPOSE[@]}" ps --status running 2>/dev/null | grep -q turret; then
      warn "The system is running and holds the ESP32 port; stopping it for the check."
      "${COMPOSE[@]}" down
    fi
    say "Container"
    "${COMPOSE[@]}" run --rm --no-deps turret python3 -m turret doctor "$@"
    ;;
  up)
    need_docker
    ensure_image
    mode="--hw"
    if [[ "${1:-}" == "--sim" ]]; then
      mode="--sim"
    elif ! esp32_present; then
      warn "No ESP32 found on USB; starting the simulator."
      mode="--sim"
    fi
    TURRET_MODE="$mode" "${COMPOSE[@]}" up -d
    ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    say "Mission Control: http://${ip:-<jetson-ip>}:8080"
    ;;
  down) need_docker; "${COMPOSE[@]}" down ;;
  logs) need_docker; "${COMPOSE[@]}" logs -f --tail 100 ;;
  update)
    git -C "$ROOT" pull --ff-only
    need_docker
    "${COMPOSE[@]}" pull || { warn "Pull failed; building locally."; "${COMPOSE[@]}" build; }
    say "Updated. Restart with: ./tv down && ./tv up"
    ;;
  flash)
    need_docker
    ensure_image
    esp32_present || fail "No ESP32 found on USB."
    if "${COMPOSE[@]}" ps --status running 2>/dev/null | grep -q turret; then "${COMPOSE[@]}" down; fi
    say "Building and flashing firmware (first run downloads the ESP32 toolchain into data/.platformio)"
    "${COMPOSE[@]}" run --rm --no-deps -w /opt/turret/firmware turret pio run -e esp32dev -t upload
    ;;
  sim) need_docker; ensure_image; "${COMPOSE[@]}" run --rm --no-deps turret python3 -m turret sim "$@" ;;
  test) need_docker; ensure_image; "${COMPOSE[@]}" run --rm --no-deps turret python3 -m pytest -q tests ;;
  shell) need_docker; ensure_image; "${COMPOSE[@]}" run --rm --no-deps turret bash ;;
  build) need_docker; "${COMPOSE[@]}" build ;;
  help|-h|--help) awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0" ;;
  *) fail "Unknown command '$cmd'. Try: ./tv help" ;;
esac
